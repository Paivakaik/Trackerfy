# Banco de dados Postgres. Local: rode um Postgres (ex: `docker run -p 5432:5432
# -e POSTGRES_PASSWORD=postgres postgres`) ou use um banco free tier (Neon,
# Supabase). Em produção na Vercel: aba Storage > Postgres (via Neon) cria essa
# URL automaticamente para você.
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Login do dashboard
ADMIN_USER="admin"
ADMIN_PASSWORD="troque-esta-senha"

# NextAuth
NEXTAUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Conector Meta Ads (Facebook/Instagram) — veja "Conectar Meta Ads" no README
# para o passo a passo de criar o App em developers.facebook.com.
META_APP_ID=""
META_APP_SECRET=""

# Protege o endpoint /api/cron/sync-meta contra chamadas externas. A Vercel
# injeta esse valor automaticamente como Bearer token quando o cron dispara —
# só precisa gerar um valor aleatório e colocar aqui e nas env vars da Vercel.
CRON_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
