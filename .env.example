# Banco de dados Postgres. Local: rode um Postgres (ex: `docker run -p 5432:5432
# -e POSTGRES_PASSWORD=postgres postgres`) ou use um banco free tier (Neon,
# Supabase). Em produção na Vercel: aba Storage > Postgres (via Neon) cria essa
# URL automaticamente para você.
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Login do dashboard
ADMIN_USER="admin"
ADMIN_PASSWORD="troque-esta-senha"

# NextAuth
NEXTAUTH_SECRET="gere-um-valor-aleatorio-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
