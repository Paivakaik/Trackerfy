datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  events        Event[]
  adSpends      AdSpend[]
  adConnections AdConnection[]
}

// "type" é restrito em código a CLICK | PAGE_VIEW | INITIATE_CHECKOUT | PURCHASE
// (ver src/lib/types.ts).
// saleStatus / paymentMethod só se aplicam a eventos do tipo PURCHASE:
// saleStatus: PAID | PENDING | REFUNDED | CHARGEBACK (padrão PAID)
// paymentMethod: PIX | CARD | BOLETO | OTHER (padrão OTHER)
// value: preço cheio pago pelo cliente (faturamento bruto).
// netValue: quanto o produtor realmente recebe depois da taxa da plataforma
// (ex: comissão "PRODUCER" do webhook do Lastlink) — null quando a origem
// não informa esse detalhe, e nesse caso o código trata como igual a value.
model Event {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          String
  sessionId     String
  value         Float?
  netValue      Float?
  taxAmount     Float?
  saleStatus    String?
  paymentMethod String?
  url           String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  adAccount     String?
  createdAt     DateTime  @default(now())

  @@index([productId, type, createdAt])
  @@index([productId, utmCampaign])
  @@index([productId, utmSource])
  @@index([productId, adAccount])
  @@index([sessionId])
}

// source: "manual" (lançado pelo usuário no dashboard) | "meta" (sincronizado
// automaticamente da Meta Ads API). Entradas "meta" são sempre diárias
// (periodStart = periodEnd = o dia). O gasto exibido no dashboard é a SOMA de
// todas as linhas cujo período cai dentro do período selecionado, então as
// duas origens se somam naturalmente sem conflito.
model AdSpend {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign    String   @default("__all__")
  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, campaign, periodStart, periodEnd, source])
}

// Conexão de uma conta de anúncios (Meta Ads) a um produto, para sincronizar
// o gasto automaticamente. accessToken é um token de usuário de vida longa
// (~60 dias) — a Meta não oferece refresh silencioso, então quando expira o
// usuário precisa reconectar pelo dashboard.
model AdConnection {
  id             String    @id @default(cuid())
  productId      String
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  platform       String    @default("meta")
  accessToken    String
  tokenExpiresAt DateTime?
  metaUserId     String?
  adAccountId    String?
  adAccountName  String?
  lastSyncedAt   DateTime?
  lastSyncError  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([productId, platform])
}
